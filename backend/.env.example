# Application
APP_NAME=Hospital Management System
APP_VERSION=1.0.0
DEBUG=True

# Database  (@ in password must be URL-encoded as %40)
DATABASE_URL=postgresql://hms_user:HMS%402026@localhost:5432/hms_db
DB_ECHO=False

# Security  (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — add your server IP / domain here
# Development:   CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production:    CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://YOUR_SERVER_IP"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Content-Security-Policy extras (space-separated extra sources per directive;
# leave empty to allow nothing beyond 'self'). Defaults below already cover
# Google-hosted user avatar photos. See config.py for what's fixed vs.
# overridable.
CSP_IMG_SRC_EXTRA=https://lh3.googleusercontent.com
CSP_CONNECT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_SCRIPT_SRC_EXTRA=

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# PRN (Patient Reference Number prefix)
PRN_PREFIX=HMS

# SMTP — required for password-reset, appointment confirmation/cancellation/
# reschedule, and welcome-credential emails. Leave SMTP_HOST empty to disable
# email sending entirely (send_email() then just logs a warning and no-ops).
# SMTP_USE_SSL=true  -> implicit SSL (typically port 465)
# SMTP_USE_TLS=true  -> STARTTLS on a plain connection (typically port 587)
# Leaving both at their defaults (false/true) falls back to inferring SSL
# from SMTP_PORT == 465 for backward compatibility.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
